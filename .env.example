# Intake Configuration
# Copy this to .env for local development

# Environment
INTAKE_ENV=local

# Base URL for the application
INTAKE_BASE_URL=http://127.0.0.1:8000

# WebAuthn / Passkey relying party configuration
INTAKE_RP_ID=localhost
INTAKE_RP_NAME=Intake Local
INTAKE_ORIGIN=http://localhost:8000

# Database URL (SQLite for local development)
INTAKE_DATABASE_URL=sqlite:///./.build/intake/local.db

# Development encryption key (32-byte base64 encoded)
# Generate with: openssl rand -base64 32
INTAKE_DEV_ENCRYPTION_KEY=

# Session secret (random string)
INTAKE_SESSION_SECRET=

# Challenge expiry in seconds (default: 5 minutes)
INTAKE_CHALLENGE_EXPIRY=300
